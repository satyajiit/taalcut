{
  "families": [
    {"id": "none", "description": "No tool. Chat, taste, definitions, clarifying questions, or a refusal to act."},
    {"id": "library", "description": "Add footage, search the bin, open an asset, or check an import."},
    {"id": "media", "description": "Inspect a file, conform it, or build editorial proxies."},
    {"id": "vision", "description": "Read a frame, find cuts, OCR, score shot quality, or index looks."},
    {"id": "audio", "description": "Beats, speech transcript, or loudness of a track."},
    {"id": "templates", "description": "Take in a reference, break it down, or save and list templates."},
    {"id": "timeline", "description": "Assemble, trim, reorder, retitle, swap, cast, or grab a still."},
    {"id": "render", "description": "Preview, caption, check, or export the finished picture."},
    {"id": "sandbox", "description": "Run a custom script that is not one of the named tools."}
  ],
  "tools": [
    {"id": "library.addSource", "family": "library", "source": "named", "wp": "P1-G7", "description": "Add a folder, card, or files to the library.", "parameters": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "description": "Folder or file path to ingest."}, "label": {"type": "string", "description": "Optional bin label."}}}},
    {"id": "library.search", "family": "library", "source": "named", "wp": "P2-L12", "description": "Search imported assets by words or tags.", "parameters": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "limit": {"type": "integer"}}}},
    {"id": "library.findSimilar", "family": "library", "source": "named", "wp": "P2-L12", "description": "Find assets that look or feel like a given one.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "limit": {"type": "integer"}}}},
    {"id": "library.getAsset", "family": "library", "source": "named", "wp": "P2-L12", "description": "Open one known asset and its details.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "library.importStatus", "family": "library", "source": "named", "wp": "P2-L12", "description": "Report how an in-progress import is going.", "parameters": {"type": "object", "properties": {"batchId": {"type": "string"}}}},
    {"id": "media.probe", "family": "media", "source": "named", "wp": "P1-G7", "description": "Read codec, size, fps, and duration without changing the file.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "media.normalise", "family": "media", "source": "derived", "wp": "P2-L4", "description": "Conform frame rate, size, or color to the project.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "targetFps": {"type": "string"}}}},
    {"id": "media.makeProxy", "family": "media", "source": "derived", "wp": "P2-L5", "description": "Make a lightweight editorial proxy.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "height": {"type": "integer"}}}},
    {"id": "vision.describeFrame", "family": "vision", "source": "named", "wp": "P1-G7", "description": "Say what is in a still frame.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "time": {"type": "string", "description": "Rational time on the asset."}}}},
    {"id": "vision.detectShots", "family": "vision", "source": "derived", "wp": "P2-L7", "description": "Find shot changes inside a clip.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "vision.ocr", "family": "vision", "source": "derived", "wp": "P2-L6", "description": "Read text burned into the picture.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "time": {"type": "string"}}}},
    {"id": "vision.embed", "family": "vision", "source": "derived", "wp": "P2-L9", "description": "Index frames so later looks can be matched.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "vision.quality", "family": "vision", "source": "derived", "wp": "P2-L8", "description": "Score focus, shake, and exposure.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "audio.beats", "family": "audio", "source": "derived", "wp": "P2-T4", "description": "Mark the beat grid of a music clip.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "audio.transcribe", "family": "audio", "source": "derived", "wp": "P2-L8", "description": "Turn speech into text.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "language": {"type": "string"}}}},
    {"id": "audio.loudness", "family": "audio", "source": "derived", "wp": "P2-M8", "description": "Measure or fix how loud a track is.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}, "targetLufs": {"type": "number"}}}},
    {"id": "templates.intake", "family": "templates", "source": "derived", "wp": "P2-T3", "description": "Start a template from a reference reel.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "templates.breakdown", "family": "templates", "source": "derived", "wp": "P2-T4", "description": "Describe the structure of a reference.", "parameters": {"type": "object", "required": ["assetId"], "properties": {"assetId": {"type": "string"}}}},
    {"id": "templates.save", "family": "templates", "source": "derived", "wp": "P2-T8", "description": "Save the current edit as a template.", "parameters": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}},
    {"id": "templates.list", "family": "templates", "source": "derived", "wp": "P2-T8", "description": "List saved templates.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}}},
    {"id": "timeline.cast", "family": "timeline", "source": "derived", "wp": "P2-M2", "description": "Assign people to roles on the timeline.", "parameters": {"type": "object", "required": ["role"], "properties": {"role": {"type": "string"}, "assetId": {"type": "string"}}}},
    {"id": "timeline.assemble", "family": "timeline", "source": "derived", "wp": "P2-M4", "description": "Build a first cut from selects.", "parameters": {"type": "object", "properties": {"templateId": {"type": "string"}}}},
    {"id": "timeline.trim", "family": "timeline", "source": "derived", "wp": "P2-M1", "description": "Shorten or tighten a clip already on the timeline.", "parameters": {"type": "object", "required": ["clipId"], "properties": {"clipId": {"type": "string"}, "edge": {"type": "string"}}}},
    {"id": "timeline.reorder", "family": "timeline", "source": "derived", "wp": "P2-M1", "description": "Change the order of clips on the timeline.", "parameters": {"type": "object", "required": ["clipId"], "properties": {"clipId": {"type": "string"}, "beforeClipId": {"type": "string"}}}},
    {"id": "timeline.editText", "family": "timeline", "source": "derived", "wp": "P2-M1", "description": "Change an existing title or lower third.", "parameters": {"type": "object", "required": ["clipId", "text"], "properties": {"clipId": {"type": "string"}, "text": {"type": "string"}}}},
    {"id": "timeline.captureFrame", "family": "timeline", "source": "named", "wp": "P2-M8", "description": "Grab a still from the playhead.", "parameters": {"type": "object", "properties": {"time": {"type": "string"}}}},
    {"id": "timeline.swapClip", "family": "timeline", "source": "derived", "wp": "PRD-6.2", "description": "Replace the clip in a timeline slot with another asset.", "parameters": {"type": "object", "required": ["clipId", "assetId"], "properties": {"clipId": {"type": "string"}, "assetId": {"type": "string"}}}},
    {"id": "render.export", "family": "render", "source": "derived", "wp": "P2-M11", "description": "Write the final delivery file.", "parameters": {"type": "object", "properties": {"preset": {"type": "string"}}}},
    {"id": "render.captions", "family": "render", "source": "derived", "wp": "P2-M5", "description": "Add or burn captions on the delivery.", "parameters": {"type": "object", "properties": {"language": {"type": "string"}}}},
    {"id": "render.qa", "family": "render", "source": "derived", "wp": "P2-M8", "description": "Check the cut before it is sent.", "parameters": {"type": "object", "properties": {"preset": {"type": "string"}}}},
    {"id": "render.preview", "family": "render", "source": "derived", "wp": "P2-M7", "description": "Render a quick preview, not the master.", "parameters": {"type": "object", "properties": {"range": {"type": "string"}}}},
    {"id": "sandbox.run", "family": "sandbox", "source": "named", "wp": "P2-T2", "description": "Run creator-supplied code in the sandbox.", "parameters": {"type": "object", "required": ["script"], "properties": {"script": {"type": "string"}, "timeoutMs": {"type": "integer"}}}}
  ]
}
