{
  "name": "@taalcut/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "shadcn/ui kit, smart-card kit, skeletons, global loader, warning card, theme engine. May import types (only) from core.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./web-boot.js": "./src/theme/web-boot.js"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests",
    "test:coverage": "vitest run --fsModuleCachePath node_modules/.vitest-cache --coverage --passWithNoTests",
    "i18n:check": "node ../../scripts/i18n.mjs check"
  },
  "dependencies": {
    "@hyperframes/player": "0.8.209",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@taalcut-vendor/page-mascot": "workspace:*",
    "@taalcut-vendor/react-bits": "workspace:*",
    "@taalcut/core": "workspace:*",
    "boneyard-js": "1.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@lingui/conf": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
