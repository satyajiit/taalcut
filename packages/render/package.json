{
  "name": "@taalcut/render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "HyperFrames compositions, timeline to frames to FFmpeg.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests",
    "test:coverage": "vitest run --fsModuleCachePath node_modules/.vitest-cache --coverage --passWithNoTests",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:shell": "node scripts/fetch-shell.mjs",
    "fetch:assets": "node scripts/fetch-fonts.mjs && node scripts/fetch-shell.mjs"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.209",
    "@hyperframes/parsers": "0.8.209",
    "@hyperframes/producer": "0.8.209",
    "@hyperframes/sdk": "0.8.209",
    "@taalcut/core": "workspace:*",
    "@taalcut/media": "workspace:*",
    "@taalcut/timeline": "workspace:*",
    "gsap": "3.15.0",
    "harfbuzzjs": "1.6.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "puppeteer-core": "25.13.0"
  }
}
