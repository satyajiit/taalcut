{
  "name": "@taalcut/library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Database driver, schema, migrations, repositories, vector index.",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache --passWithNoTests",
    "test:coverage": "vitest run --fsModuleCachePath node_modules/.vitest-cache --coverage --passWithNoTests",
    "schema:doc": "tsx scripts/schema-doc.ts",
    "bench": "tsx scripts/bench.ts",
    "places:build": "tsx scripts/build-places.ts"
  },
  "dependencies": {
    "@taalcut/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hash-wasm": "4.12.0",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "tsx": "4.23.15"
  }
}
