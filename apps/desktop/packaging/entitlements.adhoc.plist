<!--
  Local ad-hoc builds only (never shipped). entitlements.mac.plist plus
  disable-library-validation: with hardened runtime, macOS only loads
  frameworks signed by the same team, and ad-hoc signatures have no team.
-->
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript to machine code at run time (JIT). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- The voice consent card records the person's own voice (P3-B6); Info.plist says why. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
    <!-- Ad-hoc only: let the ad-hoc main binary load the ad-hoc Electron Framework. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
