{
  "name": "@taalcut/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Sandboxed React renderer: routes, pages, smart cards. No Node access.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache",
    "test:coverage": "vitest run --fsModuleCachePath node_modules/.vitest-cache --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "i18n:check": "node ../../scripts/i18n.mjs check",
    "i18n:extract": "lingui extract --clean",
    "routes:generate": "tsr generate",
    "bones:capture": "node e2e/capture-bones.mjs",
    "sounds:build": "node ../../tools/audio-packs/generate-interface-sounds.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-gujarati": "5.3.0",
    "@fontsource-variable/noto-sans-gurmukhi": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "@fontsource-variable/noto-sans-kannada": "5.3.0",
    "@fontsource-variable/noto-sans-malayalam": "5.3.0",
    "@fontsource-variable/noto-sans-oriya": "5.3.0",
    "@fontsource-variable/noto-sans-tamil": "5.3.0",
    "@fontsource-variable/noto-sans-telugu": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@taalcut/core": "workspace:*",
    "@taalcut/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "1.55.0",
    "qr": "0.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lingui/cli": "6.9.1",
    "@lingui/conf": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.41",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "boneyard-js": "1.10.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tone": "15.1.22",
    "vite": "8.3.4"
  }
}
