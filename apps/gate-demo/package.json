    "refresh:catalogue": "tsx scripts/refresh-catalogue.ts"
  },
  "dependencies": {
    "@taalcut/agent": "workspace:*",
    "@taalcut/audio": "workspace:*",
    "@taalcut/core": "workspace:*",
    "@taalcut/library": "workspace:*",
    "@taalcut/media": "workspace:*",
    "@taalcut/models": "workspace:*",
    "@taalcut/render": "workspace:*",
    "@taalcut/shorts": "workspace:*",
    "@taalcut/templates": "workspace:*",
    "@taalcut/timeline": "workspace:*",
    "@taalcut/tools": "workspace:*",
    "@taalcut/vision": "workspace:*"
  }
}
