{
  "name": "@taalcut/gate-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Headless twin of the gate demo: the real library, media, vision, render and agent packages composed the way the desktop app will, run end to end on scripted models and on a recorded model session.",
  "exports": {
    ".": "./src/index.ts"
  },
