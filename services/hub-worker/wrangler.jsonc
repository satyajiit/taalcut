{
  // SPDX-License-Identifier: AGPL-3.0-or-later
  // Copyright (C) 2026 Taalcut contributors
  "name": "taalcut-hub-worker",
  "main": "src/index.ts",
  // The newest date the pinned workerd (1.20261006.1, via wrangler 4.150.0 and @cloudflare/vitest-plugin 1.4.1)
  // runs, so the Workers test project boots the exact configuration that deploys. Raise it with those pins.
  "compatibility_date": "2026-10-13",
  "vars": {
    "HUB_REPO": "taalcut/hub",
  },
  "d1_databases": [
    {
      "binding": "RATINGS",
      "database_name": "taalcut-hub",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "SUBMIT_BURST", "namespace_id": "1001", "simple": { "limit": 1, "period": 10 } },
    { "name": "RATE_BURST", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "READ_BURST", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
  ],
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "GITHUB_APP_ID", "GITHUB_APP_INSTALLATION_ID", "INSTALL_ID_SALT"],
  },
}
