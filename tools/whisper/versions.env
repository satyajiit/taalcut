# Pinned whisper.cpp v1.9.5. build.sh refuses a SHA-256 mismatch.
# SOURCE_DATE_EPOCH is 2026-09-18 00:00:00 UTC, the same pin as FFmpeg.
# WHISPER_BUILD_NUMBER is 0 because the tarball is not a git checkout
# (build-info.cmake would otherwise leave the count at 0 anyway).

SOURCE_DATE_EPOCH=1789689600
MACOS_MIN=14.0

WHISPER_VERSION=1.9.5
WHISPER_COMMIT=d1be6fde11ac6e0407606b4e42fe72d34add8037
WHISPER_BUILD_NUMBER=0
WHISPER_URL=https://github.com/ggml-org/whisper.cpp/archive/d1be6fde11ac6e0407606b4e42fe72d34add8037.tar.gz
WHISPER_SHA256=645445da884df6dbd52b30f82d7be7c01d1767c938714e477e786b88d529e9f4

# Linux builds (build-linux.sh): in NVIDIA's CUDA 13.4.3 devel image on Ubuntu 22.04 (glibc 2.35, gcc 11.4), by
# digest, for both the CPU and the CUDA build; CMake from Kitware's release tarball. CUDA 13 compiles for Turing
# (sm_75) and newer: real code for 75, 80, 86, 89, 90 and 120, and PTX for 120 so a newer GPU can JIT it.
LINUX_BUILD_IMAGE=nvidia/cuda:13.4.3-devel-ubuntu22.04@sha256:3b82c17a0456e741524dc42f2b2432ea84446dcf24b5ff0d4a24f6f77a9e4369
LINUX_CMAKE_URL=https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-x86_64.tar.gz
LINUX_CMAKE_SHA256=0dc2e9a6860f06bf10bd8fadc03e35d9eeb4df46e33763a7e480e987758f385c
LINUX_CUDA_ARCHITECTURES="75-real;80-real;86-real;89-real;90-real;120-real;120-virtual"
