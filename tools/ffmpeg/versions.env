LCMS2_SHA256=bfc54f7bab59fbc921012014a8032e4cba4abd46db47d46b76416a8c0b2815c8

# GitHub archive of tag v7.360.1 (haasn/libplacebo). code.videolan.org resets
# the TLS handshake from this network (curl 35, connection reset by peer).
# Archive.org's captures of the GitLab tar.bz2 are Anubis HTML, not the
# tarball, so the earlier GitLab SHA-256
# 937aa5eeea596798b3274d362de2e3bd32bc537a66d149dd85043349c74dffb6 was not
# fetched. Same tag. Top directory is libplacebo-7.360.1.
LIBPLACEBO_VERSION=7.360.1
LIBPLACEBO_URL=https://github.com/haasn/libplacebo/archive/refs/tags/v7.360.1.tar.gz
LIBPLACEBO_SHA256=d05fdf90bea2f629eaa2d115e909fd356388ac639e54f77b87a018a6d76224bd

VULKAN_HEADERS_VERSION=1.4.357.0
VULKAN_HEADERS_URL=https://github.com/KhronosGroup/Vulkan-Headers/archive/refs/tags/vulkan-sdk-1.4.357.0.tar.gz
VULKAN_HEADERS_SHA256=e87dce08116151f6b6d7de6b6faf41498e87e6cf848ff16fa3bd5402190ad4a3

VULKAN_LOADER_VERSION=1.4.357.0
VULKAN_LOADER_URL=https://github.com/KhronosGroup/Vulkan-Loader/archive/refs/tags/vulkan-sdk-1.4.357.0.tar.gz
VULKAN_LOADER_SHA256=54f2537df22313768da0317dda2abdaaab7711b4081c48c869a79db343d0ae70

# Commit recorded in shaderc v2026.3 DEPS (glslang_revision). Not a floating HEAD.
GLSLANG_VERSION=168d452a4f460d24b588fed08477a81c44ee27a1
GLSLANG_URL=https://github.com/KhronosGroup/glslang/archive/168d452a4f460d24b588fed08477a81c44ee27a1.tar.gz
GLSLANG_SHA256=c167b2474af06cbab93abae8249efaf88fb79a09f30488e2a24d399e4258ce7a

# Linux only. macOS uses the operating system's VideoToolbox software fallback.
OPENH264_VERSION=2.6.0
OPENH264_URL=https://github.com/cisco/openh264/archive/refs/tags/v2.6.0.tar.gz
OPENH264_SHA256=558544ad358283a7ab2930d69a9ceddf913f4a51ee9bf1bfb9e377322af81a69

FAST_FLOAT_VERSION=8.3.1
