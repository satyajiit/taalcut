FAST_FLOAT_SHA256=7ff47ad261068517561beb0a7c1d57131f71b8be19bdbac2857c6a517a2eb53c

# Build-only Python used by libplacebo's Vulkan code generator. Not linked.
JINJA2_VERSION=3.1.6
JINJA2_URL=https://files.pythonhosted.org/packages/df/bf/f7da0350254c0ed7c72f3e33cef02e048281fec7ecec5f032d4aac52226b/jinja2-3.1.6.tar.gz
JINJA2_SHA256=0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d

MARKUPSAFE_VERSION=3.0.3
MARKUPSAFE_URL=https://files.pythonhosted.org/packages/7e/99/7690b6d4034fffd95959cbe0c02de8deb3098cc577c67bb6a24fe5d7caa7/markupsafe-3.0.3.tar.gz
MARKUPSAFE_SHA256=722695808f4b6457b320fdc131280796bdceb04ab50fe1795cd540799ebe1698

# Stable release asset, not a nightly. Universal binary; build.sh thins to arm64.
MOLTENVK_VERSION=1.4.2
MOLTENVK_URL=https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar
MOLTENVK_SHA256=f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e

# Headers only, for swscale's Vulkan SPIR-V backend. Tag of the Vulkan SDK above: commit
# 29981f65241605e08b0ede4cfeb999fe3b723c6a, the SPIRV-Headers revision the pinned glslang's known_good.json names.
SPIRV_HEADERS_VERSION=1.4.357.0
SPIRV_HEADERS_URL=https://github.com/KhronosGroup/SPIRV-Headers/archive/refs/tags/vulkan-sdk-1.4.357.0.tar.gz
SPIRV_HEADERS_SHA256=4d703067a7e06331ccb37bdfed3f9b7879cc61969a2689ae95c95db34a47ff07

# ---- linux-x64 (build-linux.sh) ----
# FFmpeg and the libraries above that both platforms use (zimg, lcms2, libplacebo with fast_float, Jinja and
# MarkupSafe, glslang, SPIRV-Headers, Vulkan-Headers) are the same pins. OpenH264 is Linux-only. The Vulkan-Loader above is built on
# Linux only to link against, not shipped (the system's libvulkan1 runs). MoltenVK is macOS only. The pins below are
# Linux only.

# The toolchain: Ubuntu 22.04 (glibc 2.35) by digest (the multi-arch index of ubuntu:22.04 on 2026-10-27), and its
# packages from Ubuntu's snapshot archive at one instant, so the image installs the same versions every time.
LINUX_BASE_IMAGE=ubuntu:22.04@sha256:e0f80c829509ef4df9e76bd8944eb7b8ec25cbb379b112a7f9448b2c77a77c9b
LINUX_APT_SNAPSHOT=20261027T000000Z
LINUX_APT_PACKAGES="build-essential clang-14 nasm pkg-config python3 autoconf automake libtool xz-utils ninja-build libva-dev"
# VA-API (Intel and AMD): linked against the system libva 2.x (headers and link stubs from 22.04's libva-dev 2.14).
LINUX_FFMPEG_VAAPI=1

# Build tools newer than 22.04's: CMake (the same release tools/whisper pins) and Meson (libplacebo needs >= 0.63).
LINUX_CMAKE_VERSION=3.31.12
LINUX_CMAKE_URL=https://github.com/Kitware/CMake/releases/download/v3.31.12/cmake-3.31.12-linux-x86_64.tar.gz
LINUX_CMAKE_SHA256=0dc2e9a6860f06bf10bd8fadc03e35d9eeb4df46e33763a7e480e987758f385c
LINUX_MESON_VERSION=1.12.1
LINUX_MESON_URL=https://github.com/mesonbuild/meson/releases/download/1.12.1/meson-1.12.1.tar.gz
LINUX_MESON_SHA256=ab0a6ca09f8ef70c564c8241fb5a23957886a0b53fb58412b5e07eaf07dba743

# PNG, the mov demuxer's compressed headers and the compressed shaders and CUDA kernels. macOS uses the system's.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.xz
ZLIB_SHA256=d7a0654783a4da529d1bb793b7ad9c3318020af77667bcae35f95d0e42a792f3

# NVENC, NVDEC/CUVID and the CUDA filters (headers only; FFmpeg dlopens the driver's libraries). Video Codec SDK
# 13.0, which needs driver 570 or newer (Taalcut asks for 580). n13.1 would need 610.
NV_CODEC_HEADERS_VERSION=13.0.19.1
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n13.0.19.1/nv-codec-headers-13.0.19.1.tar.gz
NV_CODEC_HEADERS_SHA256=eab9d02d461035a4baded23d4f2e2834e5b17934820b79cea45baaf0c85383eb

# AV1 decode in software (GPUs before Ampere have no AV1 decoder). GitHub's mirror of the tag: code.videolan.org
# and downloads.videolan.org reset the TLS handshake from this network, as for libplacebo above.
DAV1D_VERSION=1.5.4
DAV1D_URL=https://github.com/videolan/dav1d/archive/refs/tags/1.5.4.tar.gz
DAV1D_SHA256=a1d5b63d2d38ec9bd03acf643caa51fa22edd1e89c5a109c4807717216bbec07

# The CPU AV1 encoder, the AV1 export's fallback. GitHub's mirror of the GitLab tag (a stable archive).
SVT_AV1_VERSION=4.2.0
SVT_AV1_URL=https://github.com/AOMediaCodec/SVT-AV1/archive/refs/tags/v4.2.0.tar.gz
SVT_AV1_SHA256=d9cb8d5fccbed565d038ae304cb00c5610f1f62388868102ca22132e7844921b
