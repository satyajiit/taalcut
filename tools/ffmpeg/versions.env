# Pinned inputs for the Taalcut FFmpeg sidecar.
# build.sh sources this file and refuses a SHA-256 mismatch.
# SOURCE_DATE_EPOCH is 2026-09-18 00:00:00 UTC.

SOURCE_DATE_EPOCH=1789689600
MACOS_MIN=14.0

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
