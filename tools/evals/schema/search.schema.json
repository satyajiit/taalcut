{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "queryId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "hi",
        "es",
        "pt-BR"
      ]
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "filters": {
      "type": "object",
      "properties": {
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "square"
          ]
        },
        "minFrames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxFrames": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minQuality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "capturedAfter": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "capturedBefore": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "relevant": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "object",
            "properties": {
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endFrame": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "startFrame",
              "endFrame"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "asset"
        ],
        "additionalProperties": false
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "queryId",
    "language",
    "library",
    "text",
    "relevant",
    "synthetic"
  ],
  "additionalProperties": false
}
