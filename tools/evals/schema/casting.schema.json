{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "template": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "brief": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "formatId": {
                  "type": "string",
                  "minLength": 1
                },
                "targetSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "text",
                "formatId",
                "targetSeconds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "brief"
          ],
          "additionalProperties": false
        }
      ]
    },
    "slots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slotIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shotType": {
            "type": "string",
            "minLength": 1
          },
          "acceptable": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "range": {
                  "type": "object",
                  "properties": {
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "endFrame": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "startFrame",
                    "endFrame"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "asset"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slotIndex",
          "acceptable"
        ],
        "additionalProperties": false
      }
    },
    "order": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "groups": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "asset": {
                      "type": "string",
                      "minLength": 1
                    },
                    "range": {
                      "type": "object",
                      "properties": {
                        "startFrame": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "endFrame": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "startFrame",
                        "endFrame"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "asset"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "string",
                    "minLength": 1
                  },
                  "after": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "before",
                  "after"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "groups",
            "rules"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "caseId",
    "library",
    "synthetic",
    "template",
    "slots",
    "order"
  ],
  "additionalProperties": false
}
