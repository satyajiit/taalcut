{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taalcut.app/schema/hub-index.v0.schema.json",
  "title": "Taalcut hub index v0",
  "description": "Generated from @taalcut/core hubIndexSchema. build-index.mjs refuses to publish an index the app would not read.",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 0
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "templates": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "description": "HubTemplate id"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 280
          },
          "handle": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{1,29}$"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
            }
          },
          "formatId": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "vlog",
                  "dayInTheLife",
                  "talkingHead",
                  "podcastClip",
                  "ugcAd",
                  "beforeAfter",
                  "tutorial",
                  "highlightReel"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "trendFreshness": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "forkedFrom": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                    "description": "HubTemplate id"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "version"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "duration": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "rate": {
                "type": "object",
                "properties": {
                  "num": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "den": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "num",
                  "den"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "value",
              "rate"
            ],
            "additionalProperties": false
          },
          "slotCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "bpm": {
            "type": [
              "number",
              "null"
            ]
          },
          "slotStrip": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "description",
          "handle",
          "language",
          "tags",
          "formatId",
          "trendFreshness",
          "forkedFrom",
          "duration",
          "slotCount",
          "bpm",
          "slotStrip",
          "sha256",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "required": [
    "formatVersion",
    "generatedAt",
    "templates"
  ]
}
